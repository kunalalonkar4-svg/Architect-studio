# ---- required
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# ---- AI (server-side only; never sent to the browser). Leave ANTHROPIC_API_KEY empty to use the deterministic mock assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # a model id your key can use, e.g. the current Sonnet-class model from your Anthropic console
AI_PROVIDER=auto            # auto | mock | anthropic
# ---- limits / storage / runtime
STORAGE_DIR=./storage       # private; files are only served through authorised API routes
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173
FRONTEND_DIR=../frontend/dist
RUN_WORKER_IN_API=1         # 0 when running `python -m app.jobs` as separate worker processes
WORKER_THREADS=2
